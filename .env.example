# Copie este arquivo para .env e ajuste os valores
#   cp .env.example .env

# Banco de dados (local: Postgres via Docker na porta 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sistemadocuab

# Segurança (JWT) - gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_POR_UMA_CHAVE_FORTE_ALEATORIA
ALGORITHM=HS256

# Expiração do token de acesso (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Senha inicial do admin criada por seed_admin.py (troque após o primeiro login)
ADMIN_SENHA=troque-esta-senha

# Origens permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8050,http://localhost:8001,http://localhost
